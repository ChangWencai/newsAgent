# ===== 必填环境变量 =====

# 今日热榜 API Key（在 tophubdata.com 注册获取）
TOPHUB_API_KEY=your_tophub_api_key_here

# MiniMax API Key（在 platform.minimaxi.com 注册获取）
MINIMAX_API_KEY=your_minimax_api_key_here

# ===== 可选环境变量 =====

# Web 管理界面密码（未设置则管理页面无密码保护）
ADMIN_PASSWORD=your_admin_password_here

# Flask session 签名密钥（未设置则每次启动随机生成，session 重启后失效）
SECRET_KEY=your_secret_key_here

# 抖音榜单的 hashid（通过 /nodes 接口查询）
DOUYIN_NODE_HASHID=your_douyin_hashid_here

# RSS 服务配置
RSS_HOST=0.0.0.0
RSS_PORT=8081
RSS_BASE_URL=http://localhost:8081

# 默认文章风格（news/comment/entertainment/auto）
DEFAULT_STYLE=auto

# 每次抓取的热点数量
MAX_TOPICS_PER_RUN=5
